#!/usr/bin/env python3
"""Cache the observed IPv4 HTTPS exit without blocking the interactive prompt."""
import fcntl
import hashlib
import ipaddress
import json
import math
import os
from pathlib import Path
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time

ENDPOINT = 'https://1.1.1.1/cdn-cgi/trace'
MAX_AGE = 30
ROUTE_TIMEOUT = .12
CURL_TIMEOUT = 3.5


def enabled():
    return os.environ.get('POMDOCK_EXITIP', '1').lower() not in ('0', 'false', 'off', 'no')


def global_ipv4(value):
    try:
        address = ipaddress.ip_address(value)
        return (str(address) if address.version == 4 and address.is_global
                and not address.is_multicast and not address.is_reserved else None)
    except (ValueError, TypeError):
        return None


def state_signature(route, interfaces, namespace):
    """Hash local facts only; route-get asks the kernel without sending packets."""
    keys = ('dev', 'gateway', 'prefsrc', 'src', 'table', 'type', 'flags', 'nhid')
    selected = [{key: item[key] for key in keys if key in item} for item in route]
    value = json.dumps([namespace, selected, sorted(interfaces)], sort_keys=True)
    return hashlib.sha256(value.encode()).hexdigest()


def network_signature():
    try:
        route = subprocess.run(['ip', '-j', '-4', 'route', 'get', '1.1.1.1'],
                               text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               timeout=ROUTE_TIMEOUT, check=False)
        if route.returncode:
            return None
        routes = json.loads(route.stdout)
        if not isinstance(routes, list) or not routes or not all(isinstance(item, dict) for item in routes):
            return None
        interfaces = []
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as channel:
            for index, name in socket.if_nameindex():
                request = struct.pack('256s', name.encode()[:15])
                flags = struct.unpack_from('H', fcntl.ioctl(channel, 0x8913, request), 16)[0]
                try:
                    address = socket.inet_ntoa(fcntl.ioctl(channel, 0x8915, request)[20:24])
                except OSError:
                    address = ''
                interfaces.append((index, name, flags, address))
        return state_signature(routes, interfaces, os.readlink('/proc/self/ns/net'))
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, struct.error):
        return None


def identity():
    return os.geteuid(), str(Path.home().resolve())


def cache_directory(uid, home):
    base = Path(os.environ.get('XDG_CACHE_HOME') or Path(home) / '.cache')
    if not base.is_absolute():
        base = Path(home) / '.cache'
    suffix = hashlib.sha256(home.encode()).hexdigest()[:12]
    directory = base / 'pomdock' / f'exitip-{uid}-{suffix}'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = directory.stat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        raise PermissionError('exit-IP cache is not owned by this user')
    return directory


def read_cache(directory, uid, home):
    try:
        descriptor = os.open(directory / 'state.json', os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(descriptor) as stream:
            info = os.fstat(stream.fileno())
            if info.st_uid != uid or not stat.S_ISREG(info.st_mode) or info.st_size > 4096:
                return None
            value = json.load(stream)
        if isinstance(value, dict) and value.get('uid') == uid and value.get('home') == home:
            if 'ip' in value and (value['ip'] is None or global_ipv4(value['ip']) == value['ip']):
                return value
    except (OSError, ValueError, TypeError):
        pass
    return None


def fresh(value, signature, now):
    if not value or value.get('signature') != signature:
        return False
    checked = value.get('checked_at')
    return (type(checked) in (int, float) and math.isfinite(checked)
            and 0 <= now - checked < MAX_AGE)


def write_cache(directory, uid, home, signature, address):
    descriptor, temporary = tempfile.mkstemp(prefix='.exitip-', dir=directory)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(dict(uid=uid, home=home, signature=signature,
                           checked_at=time.time(), ip=address), stream)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, directory / 'state.json')
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def acquire_lock(directory, uid):
    descriptor = os.open(directory / 'refresh.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(descriptor)
        if info.st_uid != uid or not stat.S_ISREG(info.st_mode):
            raise PermissionError('invalid exit-IP refresh lock')
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return descriptor
    except BlockingIOError:
        os.close(descriptor)
        return None
    except BaseException:
        os.close(descriptor)
        raise


def observe_exit():
    try:
        result = subprocess.run([
            'curl', '-q', '--ipv4', '--noproxy', '*', '--proto', '=https',
            '--silent', '--show-error', '--fail', '--connect-timeout', '1',
            '--max-time', '3', '--max-filesize', '4096', ENDPOINT,
        ], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL, timeout=CURL_TIMEOUT, check=False)
        if result.returncode or len(result.stdout) > 4096:
            return None
        matches = [line[3:] for line in result.stdout.splitlines() if line.startswith('ip=')]
        return global_ipv4(matches[0]) if len(matches) == 1 else None
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        return None


def refresh(directory, uid, home):
    before = network_signature()
    if before is None or fresh(read_cache(directory, uid, home), before, time.time()):
        return
    address = observe_exit()
    # A lookup started on an old route must never publish its answer as current.
    if network_signature() != before:
        address = None
    write_cache(directory, uid, home, before, address)


def show(directory, uid, home):
    signature = network_signature()
    if signature is None:
        return
    cached = read_cache(directory, uid, home)
    if fresh(cached, signature, time.time()):
        address = global_ipv4(cached.get('ip'))
        if address:
            print(address)
        return
    descriptor = acquire_lock(directory, uid)
    if descriptor is None:
        return
    try:
        # The worker inherits the held lock; closing the parent's copy does not
        # release it until the detached worker exits. No shell or terminal FDs.
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'refresh', '--lock-fd', str(descriptor)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         close_fds=True, pass_fds=(descriptor,), start_new_session=True)
    finally:
        os.close(descriptor)


def main(arguments=None):
    if not enabled():
        return
    arguments = sys.argv[1:] if arguments is None else arguments
    uid, home = identity()
    try:
        directory = cache_directory(uid, home)
        if arguments in ([], ['show'], ['--show']):
            show(directory, uid, home)
        elif arguments == ['refresh']:
            descriptor = acquire_lock(directory, uid)
            if descriptor is not None:
                try:
                    refresh(directory, uid, home)
                finally:
                    os.close(descriptor)
        elif len(arguments) == 3 and arguments[:2] == ['refresh', '--lock-fd']:
            descriptor = int(arguments[2])
            try:
                os.fstat(descriptor)
                refresh(directory, uid, home)
            finally:
                os.close(descriptor)
    except (OSError, ValueError, TypeError):
        pass


if __name__ == '__main__':
    main()
